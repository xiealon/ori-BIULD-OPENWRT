#!/bin/sh
# shellcheck shell=dash
# ---------------------------------------------------------------------------
# openselfwrt 固件默认配置：LAN 地址 / 网关 / DNS / 旁路由模式 / root 密码
#
# 本文件由 builder/apply-defaults.sh + render-defaults.py 自动生成，
# 请勿手工修改；要改数值请在 GitHub Actions 输入项或 CLI 参数里改。
#
# 首次开机由 uci-defaults 机制调用；成功返回 0 后脚本会被自动删除。
# ---------------------------------------------------------------------------

# ==== 构造时注入的参数 ====
CFG_LAN_IP='__LAN_IP__'
CFG_LAN_NETMASK='__LAN_NETMASK__'
CFG_BYPASS_MODE='__BYPASS_MODE__'      # true = 旁路由(旁路网关)模式
CFG_UPSTREAM_GATEWAY='__UPSTREAM_GATEWAY__'
CFG_DNS='__DNS_SERVERS__'              # 空格分隔
CFG_HOSTNAME='__HOSTNAME__'
CFG_TIMEZONE='__TIMEZONE__'
CFG_ROOT_HASH='__ROOT_HASH__'          # 为空则保持 OpenWrt 默认空密码
CFG_INCLUDE_DOCKER='__INCLUDE_DOCKER__'
# ===========================

# --- 1. 主机名 / 时区 -------------------------------------------------------
uci -q batch <<EOF
set system.@system[0].hostname=$CFG_HOSTNAME
set system.@system[0].timezone=$CFG_TIMEZONE
set system.@system[0].zonename=Asia/Shanghai
EOF

# --- 2. root 开机密码 -------------------------------------------------------
# 只替换 /etc/shadow 里 root 的密码字段，保留其他账号不受影响
if [ -n "$CFG_ROOT_HASH" ]; then
    sed -i "s|^root:[^:]*:|root:${CFG_ROOT_HASH}:|" /etc/shadow
fi

# --- 3. LAN 地址 ------------------------------------------------------------
uci -q batch <<EOF
set network.lan.ipaddr=$CFG_LAN_IP
set network.lan.netmask=$CFG_LAN_NETMASK
EOF
[ -n "$CFG_DNS" ] && uci -q set network.lan.dns="$CFG_DNS"

# --- 4. 两种网络形态 --------------------------------------------------------
if [ "$CFG_BYPASS_MODE" = "true" ]; then
    # 旁路由：本机不是出口网关，也不发放 IP，DHCP/RA 全部交给主路由
    [ -n "$CFG_UPSTREAM_GATEWAY" ] && uci -q set network.lan.gateway="$CFG_UPSTREAM_GATEWAY"
# 防火墙放行[必须开启]
uci set firewall.@zone[1].input='ACCEPT'
# 禁用WAN口
uci set network.wan.disabled='1'
uci set network.wan6.disabled='1'
# 使lan接口为未指定状态
# 删除系统内的br_lan接口
uci del network.lan.device
uci del network.br_lan
# 创建一个br_lan接口 命名为br-lan
uci set network.br_lan=device
uci set network.br_lan.name='br-lan'
uci set network.br_lan.type='bridge'
uci set network.br_lan.bridge_empty='1'
# 删除br_lan的所有接口，查看设备上所有名称为eth，en，lan的接口，将查看到的接口添加进入br-lan接口
uci -q del network.br_lan.ports

for port in $(ls /sys/class/net/ | grep -E '^(eth|en|lan)' | grep -v -E '(lo|docker|veth|br-|tun|tap)'); do
    uci add_list network.br_lan.ports="$port"
done

# 将br-lan添加进入lan口并设置ip，掩码，网关，dns
uci set network.lan.device='br-lan'# 忽略lan口的dhcp
uci set dhcp.lan.ignore='1'
# 禁用RA路由通告
uci del dhcp.lan.ra
uci del dhcp.lan.max_preferred_lifetime
uci del dhcp.lan.max_valid_lifetime
# 禁用DHCPv6
uci del dhcp.lan.dhcpv6
# 忽略接口的NDP
uci del dhcp.lan.ndp
# 关闭dhcp页面的强制dhcp客户端（唯一客户端））
uci -q del dhcp.@dnsmasq[0].authoritative

else
    # 主路由：本机就是网关和 DNS，向客户端下发指定的 DNS
    uci -q set dhcp.lan.ignore='0'
    if [ -n "$CFG_DNS" ]; then
        DNS_OPT='6'
        for d in $CFG_DNS; do
            DNS_OPT="${DNS_OPT},${d}"
        done
        uci -q set dhcp.lan.dhcp_option="$DNS_OPT"
    fi
fi

# dnsmasq 上游服务器：显式指定时用指定的，避免兜到运营商 DNS
if [ -n "$CFG_DNS" ]; then
    uci -q del dhcp.@dnsmasq[0].server
    for d in $CFG_DNS; do
        uci -q add_list dhcp.@dnsmasq[0].server="$d"
    done
fi

uci -q commit

# --- 5. 容器服务 ------------------------------------------------------------
if [ "$CFG_INCLUDE_DOCKER" = "true" ] && [ -x /etc/init.d/dockerd ]; then
    /etc/init.d/dockerd enable
    # 数据放在 /opt/docker，别把 overlay 撑爆
    uci -q set dockerd.globals.data_root='/opt/docker'
    uci -q commit dockerd
fi

exit 0
