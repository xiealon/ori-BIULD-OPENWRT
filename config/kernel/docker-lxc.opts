# OpenWrt x86 内核为跑 Docker / LXC 所需的特性
# builder/genconfig.sh 会为每一行加上 CONFIG_KERNEL_ 前缀写入 .config，
# 因此这里只需写内核符号名，且不存在的符号会被 kconfig 忽略（跨 6.6/6.12 通用）。

# ============ namespace ============
NAMESPACES
NET_NS
PID_NS
IPC_NS
UTS_NS
USER_NS
CGROUP_DEVICE

# ============ cgroup ============
CGROUPS
CGROUP_V1
CGROUP_CPUACCT
CGROUP_FREEZER
CGROUP_SCHED
CGROUP_PIDS
CGROUP_PERF
CGROUP_RDMA
CGROUP_HUGETLB
CGROUP_NET_PRIO
CGROUP_NET_CLASSID
CPUSETS
MEMCG
MEMCG_SWAP
SWAP
BLK_CGROUP
BLK_DEV_THROTTLING
FAIR_GROUP_SCHED
CFS_BANDWIDTH
RT_GROUP_SCHED
SCHEDSTATS

# ============ 网络虚拟设备 ============
VETH
VXLAN
MACVLAN
IPVLAN
VLAN_8021Q
TUN
TAP
BRIDGE
BRIDGE_NETFILTER
BRIDGE_VLAN_FILTERING
NET_SCH_NETEM
NET_SCH_HTB
NET_SCH_INGRESS

